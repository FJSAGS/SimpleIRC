{
  "schemaVersion": 1,
  "id": "simpleirc",
  "version": "${version}",

  "name": "Simple IRC",
  "description": "A mediocre IRC client for Minecraft.",
  "authors": [
    "BasedUser",
    "8bitFra",
    "anthony4933"
  ],
  "contact": {
    "homepage": "https://baseduser.eu.org",
    "sources": "https://github.com/BasedUser/SimpleIRC"
  },

  "license": "MIT",
  "icon": "assets/simpleirc/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "org.atmosia.simpleirc.MainClient"
    ]
  },
  "mixins": [
    "simpleirc.mixins.json"
  ],

  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": "26.1.2",
    "java": ">=25",
    "owo-lib": ">=0.13.0+26.1"

  },
  "suggests": {
	"minecraft": "26.1.2"
  }
}
